# ~/.ashrc

HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/ash_history"
HISTSIZE=10000

ESC=$(printf '\033')

_pdir() {
    d=${PWD#"$HOME"}
    if [ "$d" = "$PWD" ]; then
        printf '%s' "$PWD"
    else
        printf '~%s' "$d"
    fi
}

_vcs() {
    b=$(jj log -r @ --no-graph -T 'if(bookmarks, "jj:" ++ bookmarks.join("|"), "jj:" ++ change_id.short(6))' 2>/dev/null)
    if [ -n "$b" ]; then
        printf ' %s' "$b"
        return
    fi
    b=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    [ -n "$b" ] && printf ' git:%s' "$b"
}

# PS1 é reavaliado a cada prompt pelo ash, incluindo $(...) e variáveis
PS1='${ESC}[1;34m$(_pdir)${ESC}[0m$(_vcs) > '
PS2='> '

alias grep='grep --color=always'
alias diff='diff --color=always'
alias mkdir='mkdir -p'
alias ..='cd ..'
alias ...='cd ../..'
alias h='history'
alias j=jobs
alias m="${PAGER:-less}"
alias g='grep -Ei'
alias cp='cp -ip'
alias mv='mv -i'
alias rm='rm -i'
alias tn='tmux new-session -s'
alias tl='tmux list-sessions'
alias ta='tmux attach-session'
alias sudo='doas'

mkd() { mkdir -p "$1" && cd "$1"; }

up() {
    n="${1:-1}"
    p=''
    while [ "$n" -gt 0 ]; do
        p="../$p"
        n=$((n - 1))
    done
    cd "$p"
}

ex() {
    case "$1" in
        *.tar.bz2)  tar xjf "$1"   ;;
        *.tar.gz)   tar xzf "$1"   ;;
        *.tar.xz)   tar xJf "$1"   ;;
        *.tar.zst)  tar --zstd -xf "$1" ;;
        *.tar)      tar xf "$1"    ;;
        *.bz2)      bunzip2 "$1"   ;;
        *.gz)       gunzip "$1"    ;;
        *.xz)       unxz "$1"      ;;
        *.zip)      unzip "$1"     ;;
        *.zst)      zstd -d "$1"   ;;
        *)          echo "extract: formato não reconhecido: $1" ;;
    esac
}
