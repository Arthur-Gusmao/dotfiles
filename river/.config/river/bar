#!/usr/bin/env sh

FIFO="$XDG_RUNTIME_DIR/sandbar"
[ -e "$FIFO" ] && rm -f "$FIFO"
mkfifo "$FIFO"

FG="#c5c9c5"
GOLD="#c4b28a"
DIM="#727169"

ICON_CPU="$(printf '\357\213\233')"   # microchip
ICON_MEM="$(printf '\357\224\270')"   # memory chip
ICON_DISK="$(printf '\357\202\240')"  # hdd
ICON_VOL="$(printf '\357\200\250')"   # volume-up
ICON_MUTE="$(printf '\357\200\246')"  # volume-off
ICON_CLOCK="$(printf '\357\200\227')" # clock

cpu() {
  cpu="$(grep -o "^[^ ]*" /proc/loadavg)"
}
memory() {
  memory="$(free -h | sed -n "2s/\([^ ]* *\)\{2\}\([^ ]*\).*/\2/p")"
}
disk() {
  disk="$(df -h / | awk 'NR==2{print $4}')"
}
datetime() {
  datetime="$(date "+%a %d %b %I:%M %P")"
}
vol() {
  raw="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)"
  if printf "%s" "$raw" | grep -q MUTED; then
    vol_icon="$ICON_MUTE"
    vol="muted"
  else
    vol_icon="$ICON_VOL"
    vol="$(printf "%s" "$raw" | awk '{printf "%.0f%%", $2*100}')"
  fi
}
display() {
  echo "all status ^fg($GOLD)${ICON_CPU}  ^fg($FG)${cpu}   ^fg($DIM)|   ^fg($GOLD)${ICON_MEM}  ^fg($FG)${memory}   ^fg($DIM)|   ^fg($GOLD)${ICON_DISK}  ^fg($FG)${disk}   ^fg($DIM)|   ^fg($GOLD)${vol_icon}  ^fg($FG)${vol}   ^fg($DIM)|   ^fg($GOLD)${ICON_CLOCK}  ^fg($FG)${datetime}^fg()" >"$FIFO"
}

status_loop() {
  sec=0
  while true; do
    sleep 1
    [ $((sec % 15)) -eq 0 ] && { memory; cpu; disk; }
    [ $((sec % 60)) -eq 0 ] && datetime
    vol
    display
    sec=$((sec + 1))
  done
}

status_loop &
STATUS_PID=$!
trap 'kill "$STATUS_PID" 2>/dev/null; rm -f "$FIFO"' EXIT INT TERM

while cat "$FIFO"; do :; done | sandbar \
  -font "IosevkaTerm Nerd Font:14" \
  -active-fg-color "$GOLD" \
  -active-bg-color "#282727" \
  -inactive-fg-color "$FG" \
  -inactive-bg-color "#181616" \
  -urgent-fg-color "#181616" \
  -urgent-bg-color "#ff5d62" \
  -title-fg-color "$GOLD" \
  -title-bg-color "#282727"

