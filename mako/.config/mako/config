# ~/.config/mako/config
font=IosevkaTerm Nerd Font 11
anchor=top-right
layer=overlay
width=360
height=120
outer-margin=10
margin=8
padding=12
border-size=2
border-radius=6
background-color=#282828
text-color=#ebdbb2
border-color=#83a598
progress-color=over #83a598
icons=1
max-icon-size=32
markup=1
actions=1
history=1
default-timeout=5000
sort=-time
max-history=20
format=<b>%s</b>\n%b
on-button-left=invoke-default-action
on-button-right=dismiss
[urgency=low]
border-color=#665c54
text-color=#ebdbb2
default-timeout=3000
[urgency=normal]
border-color=#83a598
[urgency=high]
background-color=#282828
text-color=#fbf1c7
border-color=#fb4934
default-timeout=0

