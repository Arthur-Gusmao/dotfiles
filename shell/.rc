# ~/.rc

HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/sh_history"
HISTSIZE=10000
ESC=$(printf '\033')

umask 022

export CDPATH=".:$HOME:$HOME/Projects"

# ---------------------------------------------------------------------------
if [ -n "$KSH_VERSION" ]; then
    set -o emacs
    set -o ignoreeof
    set -o trackall
    set -o pipefail
    set -o markdirs

    set -A complete_git_1 -- status add commit push pull log diff branch checkout rebase
    set -A complete_jj_1 -- status log diff commit describe new edit rebase bookmark
    set -A complete_kill_1 -- -9 -HUP -TERM
fi

# ---------------------------------------------------------------------------
_pdir() {
    d=${PWD#"$HOME"}
    [ "$d" = "$PWD" ] && d="$PWD" || d="~$d"
    if [ ${#d} -gt 40 ]; then
        printf '...%s' "${d#"${d%????????????????????????????????????}"}"
    else
        printf '%s' "$d"
    fi
}

_vcs() {
    b=$(jj log -r @ --no-graph -T 'if(bookmarks, "jj:" ++ bookmarks.join("|"), "jj:" ++ change_id.short(6))' 2>/dev/null)
    if [ -n "$b" ]; then
        empty=$(jj log -r @ --no-graph -T 'if(empty, "1", "0")' 2>/dev/null)
        if [ "$empty" = "0" ]; then
            printf ' %s%s%s*%s' "${ESC}[1;33m" "$b" "${ESC}[1;31m" "${ESC}[0m"
        else
            printf ' %s%s%s' "${ESC}[1;33m" "$b" "${ESC}[0m"
        fi
        return
    fi
    b=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [ -n "$b" ]; then
        if git diff --quiet 2>/dev/null && git diff --cached --quiet 2>/dev/null; then
            printf ' %sgit:%s%s' "${ESC}[1;35m" "$b" "${ESC}[0m"
        else
            printf ' %sgit:%s%s*%s' "${ESC}[1;35m" "$b" "${ESC}[1;31m" "${ESC}[0m"
        fi
    fi
}

_jobs() {
    n=$(jobs -p 2>/dev/null | wc -l | tr -d ' ')
    [ "$n" -gt 0 ] 2>/dev/null && printf ' %s[%s]%s' "${ESC}[1;33m" "$n" "${ESC}[0m"
}

_prompt_line() {
    st=$?
    printf '%s' "$(_pdir)"
    printf '%s' "$(_vcs)"
    printf '%s' "$(_jobs)"
    printf ' '
    if [ "$st" = 0 ]; then
        printf '%s❯%s' "${ESC}[1;32m" "${ESC}[0m"
    else
        printf '%s❯%s' "${ESC}[1;31m" "${ESC}[0m"
    fi
}

PS1='${ESC}[1;34m$(_prompt_line)${ESC}[0m '
PS2='> '

# ---------------------------------------------------------------------------
alias mkdir='mkdir -p'
alias ..='cd ..'
alias ...='cd ../..'
alias tn='tmux new-session -s'
alias tl='tmux list-sessions'
alias ta='tmux attach-session'
alias sudo='doas'

# ---------------------------------------------------------------------------
mkd() { mkdir -p "$1" && cd "$1"; }

up() {
    n="${1:-1}"
    p=''
    while [ "$n" -gt 0 ]; do
        p="../$p"
        n=$((n - 1))
    done
    cd "$p"
}

ex() {
    case "$1" in
        *.tar.bz2)  tar xjf "$1"   ;;
        *.tar.gz)   tar xzf "$1"   ;;
        *.tar.xz)   tar xJf "$1"   ;;
        *.tar.zst)  tar --zstd -xf "$1" ;;
        *.tar)      tar xf "$1"    ;;
        *.bz2)      bunzip2 "$1"   ;;
        *.gz)       gunzip "$1"    ;;
        *.xz)       unxz "$1"      ;;
        *.zip)      unzip "$1"     ;;
        *.zst)      zstd -d "$1"   ;;
        *)          echo "extract: unrecognized format: $1" ;;
    esac
}
