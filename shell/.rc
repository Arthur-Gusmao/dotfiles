# ~/.rc
# ---------------------------------------------------------------------------
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/history"
ESC=$(printf '\033')
SOH=$(printf '\001')
STX=$(printf '\002')
umask 022
export CDPATH=".:$HOME:$HOME/Projects"
# ---------------------------------------------------------------------------
if [ -n "$KSH_VERSION" ]; then
    set -o emacs
    set -o ignoreeof
    set -o trackall
    set -o pipefail
    set -o markdirs
    set -o utf8-mode
    set -A complete_git_1 -- status add commit push pull log diff branch checkout rebase
    set -A complete_jj_1 -- status log diff commit describe new edit rebase bookmark
    set -A complete_kill_1 -- -9 -HUP -TERM
    set -A complete_doas_1 -- do
    set -A complete_wpctl_1 -- set-volume set-mute set-default get-volume sinks list
    set -A complete_makoctl_1 -- dismiss restore list actions
    export HISTCONTROL=ignoredups:ignorespace
    bind -m '^[s=^Adoas ^E'
fi
# ---------------------------------------------------------------------------
_c() {
    _c_out="${SOH}${ESC}[${1}m${STX}${2}${SOH}${ESC}[0m${STX}"
}
_pdir() {
    typeset d
    d=${PWD#"$HOME"}
    [ "$d" = "$PWD" ] && d="$PWD" || d="~$d"
    if [ ${#d} -gt 40 ]; then
        _pdir_out="...${d#"${d%????????????????????????????????????}"}"
    else
        _pdir_out="$d"
    fi
}
_vcs() {
    typeset vb gitst b dirty line g1 g2
    _vcs_out=''
    if [ -d .jj ]; then
        vb=$(jj log -r @ --no-graph --color=always \
            -T 'separate(" ", bookmarks) ++ if(bookmarks, " ", "") ++ change_id.shortest(8) ++ if(empty, "", " +")' \
            2>/dev/null)
        if [ -n "$vb" ]; then
            _c '1;36' "jj:$vb"
            _vcs_out=" $_c_out"
            return
        fi
    fi

    gitst=$(git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null) || return
    [ -n "$gitst" ] || return

    b=''
    dirty=0
    IFS='
'
    for line in $gitst; do
        case $line in
        '# branch.head '*)
            b=${line#'# branch.head '}
            ;;
        [12u]*)
            dirty=1
            ;;
        esac
    done
    unset IFS
    [ -n "$b" ] || return

    _c '1;35' 'git:'; g1=$_c_out
    _c '1;33' "$b";   g2=$_c_out
    _vcs_out=" $g1$g2"

    if [ "$dirty" = 1 ]; then
        _c '1;31' '*'
        _vcs_out="$_vcs_out$_c_out"
    fi
}
_jobs() {
    typeset n
    n=$(jobs -p 2>/dev/null | wc -l)
    if [ "$n" -gt 0 ]; then
        _c '1;33' "[$n]"
        _jobs_out=" $_c_out"
    else
        _jobs_out=''
    fi
}
_prompt_line() {
    typeset st
    st="$1"
    _pdir
    _vcs
    _jobs
    printf '%s%s%s ' "$_pdir_out" "$_vcs_out" "$_jobs_out"
    if [ "$st" = 0 ]; then
        _c '1;32' '❯'
    else
        _c '1;31' '❯'
    fi
    printf '%s' "$_c_out"
}
PS1='$(_c 1\;34 "$(_prompt_line $?)"; printf "%s" "$_c_out") '
PS2='> '
# ---------------------------------------------------------------------------
alias lc='/bin/ls'
alias ls='ls -1 --group-directories-first'
alias cls='print -n \\Ec'
alias mkdir='mkdir -p'
alias ..='cd ..'
alias ...='cd ../..'
alias tn='tmux new-session -s'
alias tl='tmux list-sessions'
alias ta='tmux attach-session'
alias sudo='doas'
# ---------------------------------------------------------------------------
mkd() { mkdir -p "$1" && cd "$1"; }
up() {
    n="${1:-1}"
    p=''
    while [ "$n" -gt 0 ]; do
        p="../$p"
        n=$((n - 1))
    done
    cd "$p"
}
ex() {
    case "$1" in
        *.tar.bz2)  tar xjf "$1"   ;;
        *.tar.gz)   tar xzf "$1"   ;;
        *.tar.xz)   tar xJf "$1"   ;;
        *.tar.zst)  tar --zstd -xf "$1" ;;
        *.tar)      tar xf "$1"    ;;
        *.bz2)      bunzip2 "$1"   ;;
        *.gz)       gunzip "$1"    ;;
        *.xz)       unxz "$1"      ;;
        *.zip)      unzip "$1"     ;;
        *.zst)      zstd -d "$1"   ;;
        *.7z)       7z x "$1"      ;;
        *.deb)      ar x "$1"      ;;
        *.rpm)      rpm2cpio "$1" | cpio -idm ;;
        *.rar)      unrar x "$1"   ;;
        *.cab)      cabextract "$1" ;;
        *.lz)       lzip -d "$1"   ;;
        *.lzma)     unlzma "$1"    ;;
        *.Z)        uncompress "$1" ;;
        *)          echo "extract: unrecognized format: $1" ;;
    esac
}
pushd() {
    [ -z "$1" ] && return 1
    DIRSTACK="$PWD${DIRSTACK:+:$DIRSTACK}"
    cd "$1"
}
popd() {
    [ -z "$DIRSTACK" ] && return 1
    cd "${DIRSTACK%%:*}"
    DIRSTACK="${DIRSTACK#*:}"
}
