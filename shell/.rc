# ~/.rc
# ---------------------------------------------------------------------------
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/history"
umask 022
export CDPATH=".:$HOME:$HOME/Projects"
# ---------------------------------------------------------------------------
if [ -n "$KSH_VERSION" ]; then
    set -o emacs
    set -o ignoreeof
    set -o trackall
    set -o pipefail
    set -o markdirs
    set -o utf8-mode
    set -A complete_git_1 -- status add commit push pull log diff branch checkout rebase
    set -A complete_jj_1 -- status log diff commit describe new edit rebase bookmark
    set -A complete_kill_1 -- -9 -HUP -TERM
    set -A complete_doas_1 -- do
    set -A complete_wpctl_1 -- set-volume set-mute set-default get-volume sinks list
    set -A complete_makoctl_1 -- dismiss restore list actions
    export HISTCONTROL=ignoredups:ignorespace
    bind -m '^[s=^Adoas ^E'
fi
# ---------------------------------------------------------------------------
_prompt() {
    typeset st="$?" d v
    # directory
    d=${PWD#"$HOME"}
    [ "$d" = "$PWD" ] && d="$PWD" || d="~$d"
    [ ${#d} -gt 40 ] && d="...${d#"${d%????????????????????????????????????}"}"
    # vcs
    v=''
    if [ -d .jj ]; then
        v=$(jj log -r @ --no-graph --template 'bookmarks ++ if(bookmarks, " ", "") ++ change_id.shortest(8)' 2>/dev/null)
        [ -n "$v" ] && v=" jj:$v"
    fi
    if [ -z "$v" ] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        v=$(git branch --show-current 2>/dev/null)
        [ -n "$v" ] && v=" git:$v"
        git diff --quiet 2>/dev/null && git diff --cached --quiet 2>/dev/null || v="${v}*"
    fi
    # prompt
    PS1=""
    PS1="${PS1}\033[1;34m${d}"
    [ -n "$v" ] && PS1="${PS1}\033[1;36m${v}"
    if [ "$st" = 0 ]; then
        PS1="${PS1}\033[1;32m ❯"
    else
        PS1="${PS1}\033[1;31m ❯"
    fi
    PS1="${PS1}\033[0m "
}
PS1='$(_prompt; printf "%s" "$_ps1") '
PS2='> '
# ---------------------------------------------------------------------------
alias lc='/bin/ls'
alias ls='ls -1 --group-directories-first'
alias cls='print -n \\Ec'
alias mkdir='mkdir -p'
alias ..='cd ..'
alias ...='cd ../..'
alias tn='tmux new-session -s'
alias tl='tmux list-sessions'
alias ta='tmux attach-session'
alias sudo='doas'
# ---------------------------------------------------------------------------
mkd() { mkdir -p "$1" && cd "$1"; }
up() {
    n="${1:-1}"
    p=''
    while [ "$n" -gt 0 ]; do
        p="../$p"
        n=$((n - 1))
    done
    cd "$p"
}
ex() {
    case "$1" in
        *.tar.bz2)  tar xjf "$1"   ;;
        *.tar.gz)   tar xzf "$1"   ;;
        *.tar.xz)   tar xJf "$1"   ;;
        *.tar.zst)  tar --zstd -xf "$1" ;;
        *.tar)      tar xf "$1"    ;;
        *.bz2)      bunzip2 "$1"   ;;
        *.gz)       gunzip "$1"    ;;
        *.xz)       unxz "$1"      ;;
        *.zip)      unzip "$1"     ;;
        *.zst)      zstd -d "$1"   ;;
        *)          echo "extract: unrecognized format: $1" ;;
    esac
}
pushd() { cd "$1" && set -- "$OLDPWD" "$@"; DIRSTACK="$1${DIRSTACK:+:$DIRSTACK}"; }
popd() {
    [ -z "$DIRSTACK" ] && return 1
    cd "${DIRSTACK%%:*}"
    DIRSTACK="${DIRSTACK#*:}"
    [ "$DIRSTACK" = "${DIRSTACK#*:}" ] && [ "$DIRSTACK" = "${DIRSTACK%%:*}" ] || :
}
