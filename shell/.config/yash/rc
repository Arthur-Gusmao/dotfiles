#!/bin/sh

# ─── line editing (was sourced from /etc/yashrc on Alpine) ──────────
bindkey -e '^[[1;5D' backward-emacsword
bindkey -e '^[[1;5C' forward-emacsword

# ─── interactive env (PATH/env come from ~/.profile via login) ──────
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/yash/history"
mkdir -p "${HISTFILE%/*}"
umask 022
# Leading ":" = null entry = current dir (same as "." but WITHOUT the
# POSIX print of the resolved path). Don't export: cd only needs it as
# a shell variable and exporting leaks it into child scripts.
CDPATH=":$HOME:$HOME/Projects"

# ─── options ─────────────────────────────────────────────────────────
set -o emacs
set -o ignoreeof
set -o pipefail
set -o markdirs
set -o histspace
set -o notify-le
set -o le-no-conv-meta
set -o brace-expand
set -o extended-glob
set -o le-predict
#set -o le-predict-empty
export HISTRMDUP=1

# ─── prompt ──────────────────────────────────────────────────────────
_prompt_line() {
    case $PWD in
        "$HOME"|"$HOME"/*) d="~${PWD#"$HOME"}" ;;
        *) d="$PWD" ;;
    esac
    printf '%s' "$d"
    br=$(git branch --show-current 2>/dev/null)
    if [ -n "$br" ]; then
        printf ' %s' "$br"
        [ -n "$(git status --porcelain 2>/dev/null)" ] && printf '*'
    fi
    printf ' %% '
}
PS1='$(_prompt_line $?)'
PS2='> '
alias g='grep'
alias l='$PAGER'
alias --global L='|$PAGER'
alias --global N='>/dev/null 2>&1' N1='>/dev/null' N2='2>/dev/null'
alias lc='/bin/ls'
alias ls='/bin/ls -1 --group-directories-first'
alias cls='printf "\033c"'
alias mkdir='mkdir -p'
alias ..='cd ..'
alias ...='cd ../..'
alias tn='tmux new-session -s'
alias tl='tmux list-sessions'
alias ta='tmux attach-session'
alias sudo='doas'
alias packettracer='QT_QPA_PLATFORM=xcb packettracer'
# ---------------------------------------------------------------------------
mkd() { mkdir -p "$1" && cd "$1"; }
up() {
    n="${1:-1}"
    p=''
    while [ "$n" -gt 0 ]; do
        p="../$p"
        n=$((n - 1))
    done
    cd "$p"
}
