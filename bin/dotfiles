#!/bin/sh -e
# dotfiles — symlink manager

CDPATH= cd "$(dirname "$0")/.." || exit 1
repo=$(pwd)

if [ -t 1 ]; then
    esc=$(printf '\033')
    R="${esc}[31m" G="${esc}[32m" Y="${esc}[33m"
    C="${esc}[36m" B="${esc}[1m"  D="${esc}[2m" N="${esc}[0m"
fi

# ─────────────────────────────────────────────────────────────
# config
# ─────────────────────────────────────────────────────────────

DEPS="foot yash tmux kakoune vis qutebrowser librewolf xdg-desktop-portal-gtk
    river zig wayland-dev wlr-randr grim slurp wl-clipboard polkit xdg-desktop-portal-wlr
    wbg waylock wlopm bash fcft-dev pixman-dev pipewire-alsa xdg-desktop-portal
    util-linux shadow build-base libxkbcommon-dev pipewire-webrtc bmake xdg-desktop-portal-dev
    wayidle jujutsu git wireplumber pipewire playerctl brightnessctl fnott luajit
    doas seatd dbus zzz less curl ronn wayland-protocols samurai kakoune-lsp fd
    font-terminus font-inconsolata font-dejavu font-noto meson podman
    font-noto-cjk font-awesome font-noto-extra font-vollkorn distrobox
    font-misc-cyrillic font-mutt-misc font-screen-cyrillic iptables
    font-winitzki-cyrillic font-cronyx-cyrillic fastfetch flatpak
    font-noto-thai font-noto-tibetan font-ipa pipewire-pulse pipewire-jack
    font-sony-misc font-jis-misc font-isas-misc font-arabic-misc
    font-noto-arabic font-noto-armenian font-noto-cherokee clang-extra-tools
    font-noto-devanagari font-noto-ethiopic font-noto-georgian
    font-noto-hebrew font-noto-lao font-noto-malayalam
    font-noto-tamil font-noto-thaana"

SERVICES="local seatd dbus polkit cgroups"

EXCL="! -path */.git/* ! -path */doas/* ! -path */local.d/* ! -path */libinput/* ! -path "$repo/bin/*""

# ─────────────────────────────────────────────────────────────
# functions
# ─────────────────────────────────────────────────────────────

die()  { printf "  ${R}✗${N}  %s\n" "$1"; exit 1; }
ok()   { printf "  ${G}✓${N}  %s\n" "$1"; }
warn() { printf "  ${Y}⚠${N}  %s\n" "$1"; }
section() { printf "  ${B}${C}─── %s ───${N}\n" "$1"; }

need_root() {
    [ "$(id -u)" = 0 ] || { warn "run: ${B}doas $0 $1${N}"; exit 1; }
}

# find package files (skip .git, doas, local.d, bin)
pkg_files() {
    set -f
    find "${1:-$repo}" ${2:--mindepth 2} -type f $EXCL
    set +f
}

# ─────────────────────────────────────────────────────────────
# commands
# ─────────────────────────────────────────────────────────────

do_install() {
    section "installing"
    depth="-mindepth 2"
    target="$repo"
    [ -n "$1" ] && { target="$repo/$1"; depth="-mindepth 0"; }
    
    set -f
    for f in $(pkg_files "$target" "$depth"); do
        rel="${f#$repo/}"; dest="$HOME/${rel#*/}"
        mkdir -p "$(dirname "$dest")"
        
        if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$f" ]; then
            continue
        elif [ -e "$dest" ] || [ -L "$dest" ]; then
            warn "conflict  $dest"
        else
            ln -s "$f" "$dest"
            printf "  ${G}✓${N}  ${D}%s${N}\n" "$dest"
        fi
    done
    set +f
}

do_uninstall() {
    section "removing"
    set -f
    for f in $(pkg_files); do
        rel="${f#$repo/}"; dest="$HOME/${rel#*/}"
        [ -L "$dest" ] && [ "$(readlink "$dest")" = "$f" ] || continue
        rm "$dest"
        printf "  ${R}✗${N}  ${D}%s${N}\n" "$dest"
    done
    set +f
}

do_status() {
    tmp=/tmp/dotfiles-status-$$
    : > "$tmp"
    
    set -f
    for f in $(pkg_files); do
        rel="${f#$repo/}"; dest="$HOME/${rel#*/}"
        if [ -L "$dest" ]; then
            if [ "$(readlink "$dest")" = "$f" ]; then
                printf "  ${G}✓${N}  %-9s ${D}%s${N}\n" "OK" "$dest"
                echo o >> "$tmp"
            else
                printf "  ${R}✗${N}  %-9s ${D}%s${N}\n" "CONFLICT" "$dest"
                echo c >> "$tmp"
            fi
        elif [ -e "$dest" ]; then
            printf "  ${R}✗${N}  %-9s ${D}%s${N}\n" "CONFLICT" "$dest"
            echo c >> "$tmp"
        else
            printf "  ${Y}⚠${N}  %-9s ${D}%s${N}\n" "MISSING" "$dest"
            echo m >> "$tmp"
        fi
    done
    set +f
    
    ok=$(grep -c '^o$' "$tmp" 2>/dev/null) || ok=0
    conflict=$(grep -c '^c$' "$tmp" 2>/dev/null) || conflict=0
    missing=$(grep -c '^m$' "$tmp" 2>/dev/null) || missing=0
    rm -f "$tmp"
    
    printf "\n  ${D}→ %d ok · %d conflict · %d missing${N}\n" "$ok" "$conflict" "$missing"
}

do_list() {
    for d in "$repo"/*/; do
        name=$(basename "$d")
        case "$name" in .git|doas|local.d|bin) continue ;; esac
        echo "  $name"
    done
}

do_clean() {
    section "cleaning broken symlinks"
    set -f
    for l in $(find "$HOME" -maxdepth 4 -type l ! -exec test -e {} \; -print 2>/dev/null); do
        case "$l" in "$HOME/.config/opencode"*) continue ;; esac
        case "$(readlink "$l")" in "$repo"/*) 
            printf "  ${R}✗${N}  ${D}%s${N}\n" "$l"
            rm "$l"
        ;; esac
    done
    set +f
}

do_deps() {
    need_root deps
    
    if   command -v apk  >/dev/null; then cmd="apk add";               pm=apk
    elif command -v apt  >/dev/null; then cmd="apt install -y";        pm=apt
    elif command -v pacman >/dev/null; then cmd="pacman -S --noconfirm"; pm=pacman
    elif command -v dnf  >/dev/null; then cmd="dnf install -y";        pm=dnf
    elif command -v xbps-install >/dev/null; then cmd="xbps-install -S"; pm=xbps
    else die "unknown package manager"
    fi
    
    section "packages ($pm)"
    $cmd $DEPS && ok "done"
}

do_services() {
    need_root services
    
    if   command -v rc-update  >/dev/null; then init=openrc;  enable="rc-update add"
    elif command -v systemctl  >/dev/null; then init=systemd; enable="systemctl enable"
    elif command -v sv         >/dev/null; then init=runit;   enable="ln -s /etc/sv"
    else die "unknown init system"
    fi
    
    section "services ($init)"
    for svc in $SERVICES; do
        $enable "$svc" >/dev/null 2>&1 && ok "$svc" || warn "$svc"
    done
}

do_doas() {
    [ -f "$repo/doas/doas.conf" ] || die "doas.conf not found"

    # Alpine doas also reads /etc/doas.d/*.conf and the last matching rule
    # wins, so a stray drop-in can silently override doas.conf. Remove them
    # to keep doas.conf the single source of truth.
    if command -v doas >/dev/null && [ -f /etc/doas.conf ]; then
        doas install -m 0644 "$repo/doas/doas.conf" /etc/doas.conf
        doas rm -f /etc/doas.d/*.conf
    else
        warn "bootstrap (su)"
        su root -c "install -m 0644 '$repo/doas/doas.conf' /etc/doas.conf"
        su root -c "rm -f /etc/doas.d/*.conf"
    fi
    ok "installed"
}

do_locald() {
    [ -d "$repo/local.d" ] || die "local.d not found"
    section "/etc/local.d"
    
    if command -v doas >/dev/null; then
        doas mkdir -p /etc/local.d
        doas install -m 0755 "$repo/local.d"/* /etc/local.d/
    else
        warn "bootstrap (su)"
        su root -c "mkdir -p /etc/local.d && install -m 0755 '$repo/local.d'/* /etc/local.d/"
    fi
    ok "installed"
}

do_libinput() {
    [ -f "$repo/libinput/local-overrides.quirks" ] || die "libinput quirks not found"
    section "/etc/libinput/local-overrides.quirks"

    if command -v doas >/dev/null; then
        doas mkdir -p /etc/libinput
        doas install -m 0644 "$repo/libinput/local-overrides.quirks" /etc/libinput/local-overrides.quirks
    else
        warn "bootstrap (su)"
        su root -c "mkdir -p /etc/libinput && install -m 0644 '$repo/libinput/local-overrides.quirks' /etc/libinput/local-overrides.quirks"
    fi
    ok "installed"
}

do_services_list() {
    section "configured services"
    for svc in $SERVICES; do
        printf "  %s\n" "$svc"
    done
}

do_iosevka() {
    need_root iosevka
    section "Iosevka Term Nerd Font"
    fonts="/usr/local/share/fonts/iosevkaterm"
    mkdir -p "$fonts"
    
    printf "  ${D}downloading...${N}\n"
    curl -sL 'https://github.com/ryanoasis/nerd-fonts/releases/latest/download/IosevkaTerm.zip' \
        -o /tmp/iosevka.zip || die "download failed"
    
    printf "  ${D}extracting...${N}\n"
    unzip -oq /tmp/iosevka.zip -d "$fonts" || die "unzip failed"
    rm -f /tmp/iosevka.zip
    
    fc-cache -f "$fonts" 2>/dev/null
    ok "installed → $fonts"
}

do_zrwm() {
    need_root zrwm-build
    section "zrwm"

    # doas/sudo may run as root; use the invoking user's home for the fork
    user="${DOAS_USER:-${SUDO_USER:-$(id -un)}}"
    fork="$HOME/src/zrwm"
    [ "$user" != "$(id -un)" ] && fork="$(getent passwd "$user" | cut -d: -f6)/src/zrwm"

    if [ -d "$fork" ]; then
        bld="$fork"
    else
        rm -rf /tmp/zrwm
        git clone --depth 1 https://git.sr.ht/~zuki/zrwm /tmp/zrwm || die "clone failed"
        bld="/tmp/zrwm"
    fi

    printf "  ${D}building...${N}\n"
    make -C "$bld" || die "build failed (need zig, wayland-dev)"

    install -m 0755 "$bld/zrwm" "$bld/zrwm-msg" /usr/local/bin/
    ok "installed"
}

do_mew() {
    need_root mew-build
    section "mew"
    
    rm -rf /tmp/mew
    git clone --depth 1 git@github.com:Arthur-Gusmao/mew /tmp/mew || die "clone failed"
    
    printf "  ${D}building...${N}\n"
    make -C /tmp/mew || die "build failed (need fcft-dev, wayland-dev, libxkbcommon-dev)"
    
    install -m 0755 /tmp/mew/mew /tmp/mew/mew-run /usr/local/bin/
    ok "installed"
}

# ─────────────────────────────────────────────────────────────
# main
# ─────────────────────────────────────────────────────────────

case "${1:-help}" in
    help|-h|--help)
        cat <<EOF
  ${B}packages${N}
    install [pkg]    symlink packages
    uninstall        remove symlinks
    relink           uninstall + install
    status           show link state
    list             list packages
    clean            remove broken symlinks

  ${B}system${N}
    deps             install packages (run as root)
    services         enable services (run as root)
    services-list    list configured services
    system-install   install doas.conf + local.d + libinput quirks

  ${B}extras${N}
    iosevka          install Iosevka Nerd Font
    zrwm-build       build zrwm from source
    mew-build        build mew from source
    bootstrap        deps + install + services
    update           git pull + relink
EOF
        ;;
    
    install)      do_install "$2" ;;
    uninstall)    do_uninstall ;;
    relink)       do_uninstall; do_install ;;
    status)       do_status ;;
    list)         do_list ;;
    clean)        do_clean ;;
    
    deps)         do_deps ;;
    services)     do_services ;;
    services-list) do_services_list ;;
    system-install) do_doas; do_locald; do_libinput ;;
    
    iosevka)      do_iosevka ;;
    opencode)     curl -fsSL https://opencode.ai/install | sh ;;
    zrwm-build)   do_zrwm ;;
    mew-build)    do_mew ;;
    
    bootstrap)    do_deps; do_install; do_services; ok "bootstrap complete" ;;
    update)       section "update"; git pull --ff-only; do_uninstall; do_install; ok "done" ;;
    
    *)  [ -d "$repo/$1" ] && { do_install "$1"; exit 0; }
        die "unknown: $1"
        ;;
esac
