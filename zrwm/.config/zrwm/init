#!/bin/sh
modkey="super"
TAGKEYS() {
    zrwm-msg bind $modkey $(($1 + 1)) view $((1 << $1))
    zrwm-msg bind $modkey,ctrl $(($1 + 1)) toggleview $((1 << $1))
    zrwm-msg bind $modkey,shift $(($1 + 1)) tag $((1 << $1))
    zrwm-msg bind $modkey,shift,ctrl $(($1 + 1)) toggletag $((1 << $1))
}
zrwm-msg clear-rules
zrwm-msg clear-binds

# ─── launchers ───
zrwm-msg bind $modkey,shift Return spawn footclient
zrwm-msg bind $modkey p spawn mew-run -b
zrwm-msg bind $modkey Escape spawn waylock -init-color 0x282828 -input-color 0x83a598 -fail-color 0xfb4934
zrwm-msg bind $modkey,shift s spawn 'grim -g "$(slurp)" - | wl-copy'

# ─── scratchpad ─── (classic river)
scratch_tag=$((1 << 20))
all_but_scratch_tag=$(( ((1 << 32) - 1) ^ $scratch_tag ))
zrwm-msg bind $modkey Return toggleview ${scratch_tag}
zrwm-msg bind $modkey a tag ${scratch_tag}
zrwm-msg spawn-tagmask ${all_but_scratch_tag}
zrwm-msg bind $modkey BackSpace spawn footclient -a scratchpad -W 160x40
zrwm-msg rule-add -exact_appid scratchpad -tags ${scratch_tag} -float

# ─── window management ───
zrwm-msg bind $modkey,shift c killwindow
zrwm-msg bind $modkey,shift q exit
zrwm-msg bind $modkey j focusstack 1
zrwm-msg bind $modkey k focusstack -1
zrwm-msg bind $modkey,shift j pushup
zrwm-msg bind $modkey,shift k pushdown
zrwm-msg bind $modkey w togglesplit
zrwm-msg bind $modkey f togglefullscreen
zrwm-msg bind $modkey s togglefloating
zrwm-msg bind $modkey z togglesticky

# ─── master factor ───
zrwm-msg bind $modkey h setmfact -0.05
zrwm-msg bind $modkey l setmfact 0.05

# ─── reload ───
zrwm-msg bind $modkey r reload

# ─── layouts ───  (shift+s is screenshot; float on shift+f)
zrwm-msg bind $modkey,shift w setlayout split_tile
zrwm-msg bind $modkey,shift f setlayout float
zrwm-msg bind $modkey,shift d setlayout deck

# ─── tags ───
TAGKEYS 0; TAGKEYS 1; TAGKEYS 2; TAGKEYS 3; TAGKEYS 4
TAGKEYS 5; TAGKEYS 6; TAGKEYS 7; TAGKEYS 8

zrwm-msg bind $modkey 0 view $(((1 << 31) - 1))
zrwm-msg bind $modkey,shift 0 tag $(((1 << 31) - 1))

# ─── mouse ───
zrwm-msg bind-mouse $modkey left moveresize 1
zrwm-msg bind-mouse $modkey middle togglefloating 0
zrwm-msg bind-mouse $modkey right moveresize 2

# ─── multimedia keys ───
zrwm-msg bind none XF86Eject spawn eject -T
zrwm-msg bind none XF86AudioRaiseVolume spawn wpctl set-volume @DEFAULT_AUDIO_SINK@ 2.5%+
zrwm-msg bind none XF86AudioLowerVolume spawn wpctl set-volume @DEFAULT_AUDIO_SINK@ 2.5%-
zrwm-msg bind none XF86AudioMute spawn wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
zrwm-msg bind none XF86AudioMedia spawn playerctl play-pause
zrwm-msg bind none XF86AudioPlay spawn playerctl play
zrwm-msg bind none XF86AudioPause spawn playerctl pause
zrwm-msg bind none XF86AudioPrev spawn playerctl previous
zrwm-msg bind none XF86AudioNext spawn playerctl next
zrwm-msg bind none XF86MonBrightnessUp spawn brightnessctl set +5%
zrwm-msg bind none XF86MonBrightnessDown spawn brightnessctl set 5%-

# ─── display ───
zrwm-msg bind $modkey o spawn wlopm --on DP-1

# ─── keyboard layout ───
zrwm-msg xkb-rule -layout us -variant altgr-intl
zrwm-msg xkb-rule default -layout us -variant altgr-intl

# ─── touchpad ───
zrwm-msg input-rule -tap-to-click 1

# ─── appearance ───
zrwm-msg borderpx 1
zrwm-msg bordercolor 665c54ff
zrwm-msg focuscolor 83a598ff
#zrwm-msg setcursor plan9 24

# ─── rules ───
zrwm-msg rule-add -appid steam -float -inverse_title Steam
zrwm-msg rule-add -appid "steam_app_" -float
zrwm-msg rule-add -appid xdg-desktop-portal-gtk -float
zrwm-msg rule-add -appid librewolf -tags $((1 << 0)) -followtags
zrwm-msg rule-add -appid librewolf -title "Picture-in-Picture" -float

# ─── initial layout ───
zrwm-msg setlayout 0
